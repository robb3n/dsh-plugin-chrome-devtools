{
  "name": "dsh-plugin-chrome-devtools",
  "version": "1.0.0",
  "type": "module",
  "description": "在 DeepSeek Harness 中通过 Chrome DevTools MCP 操作独立的 Chrome 浏览器。",
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robb3n/dsh-plugin-chrome-devtools.git"
  }
}
